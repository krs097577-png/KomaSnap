<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KomaSnap;assembly=__KOMASNAP_ASSEMBLY__"
        Title="在线漫画 · KomaSnap" Width="790" Height="650" MinWidth="560" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource App}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True">
  <Window.Resources>
    <DataTemplate x:Key="MangaResult">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Width="60" Height="80" Background="{DynamicResource Elevated}" CornerRadius="4" ClipToBounds="True">
          <Grid>
            <Path Data="M2,3 H17 V21 H2 Z M6,8 H13 M6,12 H13" Width="17" Height="19"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Stroke="{DynamicResource BorderHover}" StrokeThickness="1.1" Stretch="Uniform"/>
            <local:OnlineCoverImage Stretch="UniformToFill"/>
          </Grid>
        </Border>
        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" TextTrimming="CharacterEllipsis"
                     FontSize="16" FontWeight="SemiBold"/>
          <Border Background="{DynamicResource Elevated}" CornerRadius="5" HorizontalAlignment="Left"
                  Padding="7,2" Margin="0,5,0,0">
            <TextBlock Text="{Binding SourceName}" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
          </Border>
          <TextBlock Text="{Binding Details}" Foreground="{DynamicResource TextSecondary}"
                     FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,5,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Details}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="ChapterResult">
      <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" TextTrimming="CharacterEllipsis"/>
    </DataTemplate>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource BorderHover}"/>
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent"
                    BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Pressed}"/>
                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="在线漫画" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,15"/>
    <Expander Grid.Row="1" Header="管理漫画源" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12">
      <StackPanel Margin="0,8,0,0">
        <DockPanel LastChildFill="True">
          <Button x:Name="ImportRules" DockPanel.Dock="Right" Content="导入 JSON 规则…" Margin="7,0,0,0"/>
          <Button x:Name="ResetCatalog" DockPanel.Dock="Right" Content="恢复默认" Margin="7,0,0,0"/>
          <Button x:Name="ImportCatalog" DockPanel.Dock="Right" Content="导入索引" Margin="7,0,0,0"
                  ToolTip="导入 Mangayomi 或 Mihon 仓库索引"/>
          <TextBox x:Name="CatalogAddress" AutomationProperties.Name="漫画源索引地址"/>
        </DockPanel>
        <TextBlock x:Name="CatalogSummary" Foreground="{DynamicResource TextSecondary}"
                   TextWrapping="Wrap" Margin="0,6,0,0"/>
      </StackPanel>
    </Expander>
    <DockPanel x:Name="SearchBar" Grid.Row="2" Margin="0,0,0,12" LastChildFill="True">
      <Button x:Name="SearchButton" DockPanel.Dock="Right" Content="搜索" MinWidth="68" Margin="8,0,0,0"/>
      <ComboBox x:Name="Sources" DockPanel.Dock="Right" MinWidth="145" Margin="8,0,0,0"
                VerticalContentAlignment="Center" AutomationProperties.Name="搜索来源"/>
      <TextBox x:Name="Query" AutomationProperties.Name="漫画书名" MaxLength="120"
               ToolTip="输入漫画书名，按 Enter 搜索"/>
    </DockPanel>
    <DockPanel x:Name="ChapterBar" Grid.Row="2" Margin="0,0,0,12" Visibility="Collapsed">
      <Button x:Name="Back" Content="← 搜索结果" Margin="0,0,10,0"/>
      <Button x:Name="ChapterOrder" DockPanel.Dock="Right" Content="最新在前" Margin="8,0,0,0"
              ToolTip="切换章节正序和倒序"/>
      <CheckBox x:Name="TrimMargins" DockPanel.Dock="Right" Content="自动裁边" Margin="8,0,0,0"
                VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"
                ToolTip="减少漫画页四周的白边或黑边"/>
      <TextBlock x:Name="SeriesTitle" VerticalAlignment="Center" FontWeight="SemiBold"
                 TextTrimming="CharacterEllipsis"/>
    </DockPanel>
    <TextBlock x:Name="Status" Grid.Row="3" Foreground="{DynamicResource TextSecondary}"
               TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
    <ListBox x:Name="Entries" Grid.Row="4" Background="{DynamicResource Surface}"
             BorderBrush="{DynamicResource Border}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ItemTemplate="{StaticResource MangaResult}" VirtualizingPanel.VirtualizationMode="Recycling"/>
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="RetryPages" Content="重试解析" Visibility="Collapsed"/>
      <Button x:Name="OpenInBrowser" Content="浏览器打开" IsEnabled="False"/>
      <Button x:Name="OpenSelection" Content="查看章节" MinWidth="84" IsEnabled="False"
              ToolTipService.ShowOnDisabled="True"/>
      <Button Content="关闭" IsCancel="True" Margin="0"/>
    </StackPanel>
  </Grid>
</Window>

