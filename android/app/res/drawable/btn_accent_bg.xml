<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#E0B96E" />
            <corners android:radius="5dp" />
            <stroke android:width="1dp" android:color="#E0B96E" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#5A4E3C" />
            <corners android:radius="5dp" />
            <stroke android:width="1dp" android:color="#5A4E3C" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F6CD81" />
            <corners android:radius="5dp" />
            <stroke android:width="1dp" android:color="#F6CD81" />
        </shape>
    </item>
</selector>
